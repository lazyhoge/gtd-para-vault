filters:
  and:
    - '!file.inFolder("templates")'
    - type == "goal"
properties:
  outcome:
    displayName: 達成した状態
  due:
    displayName: 期限
  area:
    displayName: Area
  parent:
    displayName: 親の目標
  actual:
    displayName: 実績(分)
views:
  - type: table
    name: 進行中の目標
    filters:
      and:
        - status == "active"
    order:
      - file.name
      - outcome
      - due
      - area
      - parent
      - actual
    sort:
      - property: due
        direction: ASC
  - type: table
    name: 達成・中止
    filters:
      or:
        - status == "achieved"
        - status == "dropped"
    order:
      - file.name
      - status
      - outcome
      - actual
