filters:
  and:
    - '!file.inFolder("templates")'
    - type == "task"
    - status == "pending"
formulas:
  days_overdue: if(due, (now() - (due + "86399s")).days, 0)
  u_due: if(due, if(formula.days_overdue >= 7, 1, if(formula.days_overdue >= -14, (formula.days_overdue + 14) * 0.8 / 21 + 0.2, 0.2)), 0)
  u_age: if(entry, min((now() - entry).days / 365, 1), 1)
  u_tags: if(tags, if(tags.length >= 3, 1, if(tags.length == 2, 0.9, if(tags.length == 1, 0.8, 0))), 0)
  u_annotations: if(annotations, if(annotations.length >= 3, 1, if(annotations.length == 2, 0.9, if(annotations.length == 1, 0.8, 0))), 0)
  u_priority: if(priority == "H", 6, if(priority == "M", 3.9, if(priority == "L", 1.8, 0)))
  blocks: file.backlinks.filter(value.asFile().properties.status == "pending" && list(value.asFile().properties.depends).contains(file)).length
  urgency: (if(tags && tags.contains("next"), 15, 0) + 12 * formula.u_due + formula.u_priority + if(scheduled && scheduled < now(), 5, 0) + if(start, 4, 0) + 2 * formula.u_age + formula.u_tags + formula.u_annotations + if(project, 1, 0) + if(formula.blocks > 0, 8, 0) - if(status == "waiting", 3, 0)).round(1)
  elapsed: if(start, (now() - start).minutes.round(), "")
properties:
  description:
    displayName: 内容
  formula.elapsed:
    displayName: 経過(分)
  formula.blocks:
    displayName: 止めている数
  formula.urgency:
    displayName: 緊急度
  priority:
    displayName: 重要度
  project:
    displayName: Project
  start:
    displayName: 開始
  scheduled:
    displayName: 予定
  due:
    displayName: 期限
  estimate:
    displayName: 見積(分)
  actual:
    displayName: 実績(分)
  waiting_on:
    displayName: 待ち相手
  tags:
    displayName: タグ
views:
  - type: table
    name: 次の行動
    filters:
      and:
        - tags.contains("next")
        - '!tags.contains("waiting")'
    order:
      - file.name
      - description
      - formula.urgency
      - formula.blocks
      - priority
      - project
      - scheduled
      - due
      - estimate
      - tags
    sort:
      - property: formula.urgency
        direction: DESC
      - property: estimate
        direction: ASC
  - type: table
    name: 未完了すべて
    order:
      - file.name
      - description
      - formula.urgency
      - priority
      - project
      - scheduled
      - due
      - tags
    sort:
      - property: formula.urgency
        direction: DESC
      - property: estimate
        direction: ASC
  - type: table
    name: 上位10件
    filters:
      and:
        - tags.contains("next")
        - '!tags.contains("waiting")'
    order:
      - description
      - formula.urgency
      - priority
      - project
      - due
      - estimate
    sort:
      - property: formula.urgency
        direction: DESC
      - property: estimate
        direction: ASC
    limit: 10
    columnSize:
      note.description: 278
  - type: table
    name: 作業中
    filters:
      and:
        - start
    order:
      - description
      - start
      - formula.elapsed
      - estimate
      - actual
      - project
    sort:
      - property: start
        direction: ASC
